# サイトの公開URL（OGP・canonical・sitemap に使用）
# 省略時は Vercel の本番ドメイン（独自ドメイン接続後はそのドメイン）を自動で使用
NEXT_PUBLIC_SITE_URL=

# ───────────────────────────────
# お知らせ（/news）: WordPress REST API
# ───────────────────────────────
# WordPressの REST API ベースURL（サーバー専用・センシティブにしないでください）
# 例) https://wp.haruju-kaigo.com/wp-json/wp/v2
#     ドメインだけ（https://wp.haruju-kaigo.com）を入れても自動で /wp-json/wp/v2 を補完します。
# 未設定のあいだは lib/news.ts のフォールバック記事が表示され、サイトは正常に動作します。
# ※ 設定後は Vercel で再デプロイが必要です。
WP_API_BASE_URL=
# 旧名（互換のため残置。どちらか一方でOK）
NEXT_PUBLIC_WP_API_BASE_URL=

# ───────────────────────────────
# 専門コラム（/column）: 自動生成（GitHub Actions で使用）
# ───────────────────────────────
# ローカルで scripts/generate-daily-column.ts を試す場合のみ必要。
# 本番の自動生成は GitHub Secrets の ANTHROPIC_API_KEY を使用します。
ANTHROPIC_API_KEY=
# 省略時は claude-haiku-4-5-20251001 を使用
ANTHROPIC_MODEL=

# ───────────────────────────────
# お問い合わせフォーム（/contact → /api/contact）: Resend でメール送信
# ───────────────────────────────
# 未設定のあいだは、フォーム送信時に「メールアプリで送信」する案内に切り替わります。
# https://resend.com で APIキーを発行し、送信元ドメインを認証してください。
RESEND_API_KEY=
# 送信元（認証済みドメインのアドレス） 例) はるじゅ ホームページ <form@haruju.net>
CONTACT_FROM_EMAIL=
# 受信先（省略時は会社のメールアドレス nae.isogo@haruju.net）
CONTACT_TO_EMAIL=
